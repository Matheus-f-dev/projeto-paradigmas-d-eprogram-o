{
  "name": "cronicas-da-cidadela",
  "productName": "Crônicas da Cidadela",
  "version": "1.0.0",
  "private": true,
  "description": "RPG medieval por turnos — trabalho acadêmico de POO, SOLID e paradigmas de programação.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.1.1",
    "@fontsource/cinzel-decorative": "5.1.1",
    "@fontsource/eb-garamond": "5.1.1",
    "framer-motion": "11.18.2",
    "mermaid": "11.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "43.7.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "wait-on": "8.0.1"
  }
}
